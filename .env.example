# ==================== Environment ====================
ENVIRONMENT=development

# ==================== Local-dev conveniences (NEVER enable in production) ====================
# All of these are ignored when ENVIRONMENT=production. Leave unset/false for real deploys.
# Allow agent login with ANY password (throwaway test bots — skips the password check).
DEV_LOGIN_ANY_PASSWORD=false
# Seed sample market-intel snapshots (news/macro/ETF/stocks) so the Financial Events
# board works without Alpha Vantage / FRED / Finnhub keys. Seeds only empty tables.
DEV_MARKET_INTEL_SEED=false

# ==================== Database ====================
# MySQL takes precedence when DATABASE_URL is set.
# Leave empty for local SQLite development.
DATABASE_URL=
# Example MySQL URL (requires mysql+pymysql:// scheme):
# DATABASE_URL=mysql+pymysql://ai_trader:change-me@127.0.0.1:3306/ai_trader

# SQLite fallback path when DATABASE_URL is empty.
DB_PATH=service/server/data/sooppiy.db

# ==================== API Keys ====================
ALPHA_VANTAGE_API_KEY=demo

# ==================== AI / LLM provider (multi-provider) ====================
# Powers AI-generated market commentary (service/server/llm_client.py).
# Pick ONE provider with LLM_PROVIDER, then set that provider's key below.
# If LLM_PROVIDER is empty, the first provider with a key set is auto-selected.
# If none is configured, the app falls back to deterministic (non-AI) summaries.
#
#   LLM_PROVIDER = openai | gemini | grok | qwen | glm | local | openrouter | anthropic
LLM_PROVIDER=
# Optional: force a specific model (otherwise a sensible per-provider default is used).
LLM_MODEL=

# OpenAI            https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini     https://aistudio.google.com/apikey   (OpenAI-compatible endpoint)
GEMINI_API_KEY=
# xAI Grok          https://console.x.ai
XAI_API_KEY=
# Alibaba Qwen      https://dashscope.console.aliyun.com  (DashScope, OpenAI-compatible)
DASHSCOPE_API_KEY=
# Zhipu GLM         https://open.bigmodel.cn
GLM_API_KEY=
# OpenRouter        https://openrouter.ai/keys  (proxies many models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Anthropic Claude  https://console.anthropic.com
ANTHROPIC_API_KEY=

# Local LLM (Ollama / LM Studio / vLLM — anything OpenAI-compatible).
# Set LLM_PROVIDER=local to use it. No cloud key needed.
#   Ollama:   run `ollama serve`, then `ollama pull llama3.1`
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_API_KEY=

# ==================== Multi-agent analysis engine (analysis_agents.py) ====================
# Data sources for the News / Sentiment / Fundamentals-Macro / Technical analysts.
# All optional — each analyst gracefully skips a source when its key is missing.
#
# FinnHub — company & market news        https://finnhub.io/register  (free tier)
FINNHUB_API_KEY=
# FRED — US macro data (rates, CPI, unemployment)  https://fredaccount.stlouisfed.org/apikeys  (free)
FRED_API_KEY=
# StockTwits sentiment is a public endpoint (no key). Reddit / X sentiment need their own
# API credentials and are optional; leave blank to skip those sources.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Number of analyst->trader debate rounds (higher = deeper, more tokens).
ANALYSIS_DEBATE_ROUNDS=1
# How often (seconds) the automation worker checks for due auto-trading rules.
AUTOMATION_TICK_INTERVAL=60

# ==================== Trading Runs (Plan 10 — default off; ships dark) ====================
# When on: the trading_runs worker loop executes user-created auto-trading runs
# (lease-claimed DB state machines; see docs/plan/10-ai-auto-trading-runs.md).
AUTO_TRADING_ENABLED=false
# Scheduler scan cadence (seconds) for arming, stop evaluation, and due cycles.
RUN_TICK_INTERVAL=30
# Max concurrent LLM trade cycles (dedicated thread pool, never the shared one).
RUN_CYCLE_CONCURRENCY=4
# Cycle lease TTL (seconds); must exceed the worst-case analysis duration.
RUN_LEASE_TTL=300
# Server-side plan enforcement (PLAN_LIMITS in entitlements.py) for runs AND
# auto-executing automation rules. Ships dark until the tier numbers are final.
# NOTE: the SMS tier gate is always on regardless (per-message cost).
ENTITLEMENTS_ENFORCED=false

# ==================== Risk Engine (Phase 1 — default off until verified) ====================
# When on: every automation order passes the risk gate (Kelly sizing, daily-loss
# and symbol-exposure limits, circuit breaker) and the SL/TP watcher auto-closes
# positions that hit their stop-loss/take-profit.
RISK_ENGINE_ENABLED=false
# How often (seconds) the SL/TP watcher checks open positions against polled prices.
RISK_WATCHER_INTERVAL=30

# ==================== Psych Feed (Phase 2 — default off until verified) ====================
# When on: hourly snapshots of Fear & Greed (alternative.me), news-sentiment spike
# z-scores, a volatility shock proxy (OKX candles, labeled estimated), and Polymarket
# odds. Served at GET /api/market-intel/psych and fed to the sentiment analyst.
PSYCH_FEED_ENABLED=false
PSYCH_REFRESH_INTERVAL=3600

# ==================== Crypto Quant (Phase 3 — default off until verified) ====================
# When on: the analysis engine's crypto technical path computes real RSI(14),
# MA(5/20/60), 24h σ, funding rate, and spot-perp basis from OKX instead of the
# spot price alone.
QUANT_CRYPTO_ENABLED=false

# ==================== Cross-market signals (card 16 — default off until verified) ====================
# Kimchi premium (Upbit KRW-BTC vs OKX through USD/KRW — all keyless) plus the
# FRED broad-dollar index (needs FRED_API_KEY above). GET /api/market-intel/cross.
CROSS_MARKET_ENABLED=false
# Interpretation thresholds (%): premium >= hot = local overheating; <= discount = demand contraction.
# KIMCHI_HOT_PCT=3.0
# KIMCHI_DISCOUNT_PCT=-0.5

# ==================== Macro event calendar (card 07 — always on, static data) ====================
# GET /api/market-intel/events serves FOMC/CPI/jobs schedules from a verified
# static table (no API). EVENT_GUARD_ENABLED additionally makes automation skip
# new entries inside a release window (scheduled-volatility protection).
EVENT_GUARD_ENABLED=false
# Release window size in minutes around each event.
# EVENT_WINDOW_BEFORE_MINUTES=60
# EVENT_WINDOW_AFTER_MINUTES=60

# ==================== Which-coin Scanner (Phase 4 — default off until verified) ====================
# When on: hourly scans rank candidates from OKX volume surges (24h vs 7d avg),
# StockTwits mention-rate spikes, and new OKX listings. Served at
# GET /api/scanner/candidates; automation rules with symbol=SCANNER analyze the top pick.
SCANNER_ENABLED=false
SCANNER_INTERVAL=3600
SCANNER_UNIVERSE=30
SCANNER_MENTION_SYMBOLS=BTC,ETH,SOL,DOGE,XRP

# ==================== Analysis memory (Plan 11 F4) ====================
# After each analysis a brief-tier call distills at most 2 durable lessons into
# agent_memory; the next analysis for that agent recalls the most relevant ones
# (same symbol first, then recent) into the decision and verify prompts.
# Memory only informs the prompt — every risk gate downstream stays deterministic.
ANALYSIS_MEMORY_ENABLED=true

# ==================== Redis (optional — enables cross-process rate limits & auth codes) ====================
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=ai_trader

# ==================== Email (optional — enables transactional verification codes) ====================
# Sign up at https://resend.com and verify your sending domain.
RESEND_API_KEY=
EMAIL_FROM=noreply@sooppiy.com

# ==================== Frontend ====================
# Frontend auto-refresh interval in milliseconds.
VITE_REFRESH_INTERVAL=300000

# ==================== Network / CORS ====================
SOOPPIY_CORS_ORIGINS=http://localhost:3000,https://app.sooppiy.com,https://sooppiy.com

# ==================== Market Data Endpoints ====================
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com

# ==================== Background Tasks ====================
# SOOPPIY_WORKER_ROLE — one of: all (default), prices, settlement, research
# Run multiple worker processes side-by-side, one per role, to scale roles
# independently. Each role uses its own singleton lock so they coexist.
# SOOPPIY_WORKER_ROLE=all

POSITION_REFRESH_INTERVAL=300
MAX_PARALLEL_PRICE_FETCH=5
POLYMARKET_SETTLE_INTERVAL=60
MARKET_NEWS_REFRESH_INTERVAL=900
MACRO_SIGNAL_REFRESH_INTERVAL=900
ETF_FLOW_REFRESH_INTERVAL=900
STOCK_ANALYSIS_REFRESH_INTERVAL=1800

# ==================== Profit History Retention ====================
# Keep recent history at full resolution.
PROFIT_HISTORY_FULL_RESOLUTION_HOURS=24

# Keep compacted history inside this rolling window.
PROFIT_HISTORY_COMPACT_WINDOW_DAYS=7

# Bucket size used when compacting older profit history.
PROFIT_HISTORY_COMPACT_BUCKET_MINUTES=15

# Minimum interval between prune/compact passes.
PROFIT_HISTORY_PRUNE_INTERVAL_SECONDS=3600

# ==================== Price Fetch Reliability ====================
PRICE_FETCH_TIMEOUT_SECONDS=10
PRICE_FETCH_MAX_RETRIES=2
PRICE_FETCH_BACKOFF_BASE_SECONDS=0.35
PRICE_FETCH_ERROR_COOLDOWN_SECONDS=20
PRICE_FETCH_RATE_LIMIT_COOLDOWN_SECONDS=60

# ==================== Deploy (docker-compose.yml) ====================
# docker-compose.yml contains ZERO hardcoded values — every port, image, tag
# and path is interpolated from THIS file. Missing values fail loudly.
# Dev values below; the prod box (/home/ec2-user/sooppiy/.env) sets its own
# (SOOPPIY_BUILD_CONTEXT=./app, publish on 127.0.0.1 behind host nginx, etc.)
SOOPPIY_BUILD_CONTEXT=.
SOOPPIY_IMAGE=sooppiy-backend:dev
SOOPPIY_BACKEND_NAME=sooppiy-backend
SOOPPIY_WORKER_NAME=sooppiy-worker
SOOPPIY_ADMIN_NAME=sooppiy-admin
SOOPPIY_BACKEND_INTERNAL_PORT=8001
SOOPPIY_BACKEND_PUBLISH=8001
SOOPPIY_DATA_VOLUME=sooppiy_data
# prod-profile admin console (static nginx) — unused in dev
SOOPPIY_ADMIN_IMAGE=nginx:alpine
SOOPPIY_ADMIN_PUBLISH=127.0.0.1:8201
SOOPPIY_ADMIN_SITE_DIR=./admin-site
SOOPPIY_ADMIN_NGINX_CONF=./admin-nginx.conf
# dev-profile frontend (Vite dev server in a node container)
SOOPPIY_FRONTEND_NODE_IMAGE=node:20-bookworm-slim
SOOPPIY_FRONTEND_DEV_PORT=3000
SOOPPIY_FRONTEND_PROXY_TARGET=http://backend:8001
# true → the API container also runs the background loops (dev convenience).
# In prod this MUST be false: the worker container owns the loops, and true
# duplicates all ~28 of them (double automation ticks / LLM spend).
SOOPPIY_API_BACKGROUND_TASKS=true

# ==================== Broker Execution Layer (Phase 2) ====================
# Alpaca — paper trading sandbox (set ALPACA_PAPER=false for live)
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_PAPER=true

# Binance — testnet (set BINANCE_TESTNET=false for live)
BINANCE_KEY=
BINANCE_SECRET=
BINANCE_TESTNET=true

# Broker API endpoints (defaults are the official hosts; override for tests
# or a mock venue — never hardcode these in source)
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets/v2
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision/api/v3
BINANCE_LIVE_BASE_URL=https://api.binance.com/api/v3

# Live-gateway worker loops (seconds)
GATEWAY_KEEPALIVE_INTERVAL=60
ORDER_RECONCILE_INTERVAL=120

# AES-GCM key for encrypting broker credentials at rest.
# Generate: python -c "from execution.crypto import generate_key_b64; print(generate_key_b64())"
EXECUTION_ENCRYPTION_KEY=

# ==================== Auth — OAuth providers (Phase 5) ====================
# Google OAuth: create credentials at https://console.cloud.google.com/apis/credentials
# Set the redirect URI to your app domain, e.g. https://app.sooppiy.com/auth/google/callback
# All three values are required to enable the "Sign in with Google" flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Apple Sign In + Phone (SMS via Twilio) — Phase 5b/5c, not implemented yet.
# These are NOT read by the backend today: the provider list hardcodes
# apple/phone to false and there are no routes_oauth handlers for them.
# Setting these keys alone will NOT enable the buttons — the backend flow
# (routes_oauth) has to be built first. Kept here as the intended var names.
# APPLE_TEAM_ID=
# APPLE_CLIENT_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ==================== Real ETF flows (card 08 — SoSoValue, free tier) ====================
# Sign up at https://sosovalue.com/developer. When set, the ETF-flow summary
# switches from the price x volume estimate to real aggregate dollar flows
# (daily/5d/cumulative net inflow for the US spot BTC + ETH ETF complexes).
# Per-ETF rows stay estimated (free tier exposes complex-level aggregates).
SOSOVALUE_API_KEY=
# SOSOVALUE_BASE_URL=https://openapi.sosovalue.com/openapi/v1

# ==================== Real liquidations (card 11 — OKX, keyless) ====================
# Psych-feed shock rows carry real OKX liquidation aggregates (1h count,
# notional, long/short split). Last-hour notional at/above this threshold
# flags a cascade shock regardless of the sigma proxy.
# LIQ_SHOCK_NOTIONAL_USD=5000000

# ==================== Future signal sources (not read by code yet) ====================
# These unlock research card 09 (token unlocks — DefiLlama moved it behind
# their paid API), the liquidation heatmap/backfill half of card 11, and
# 13/14 (exchange netflow, smart money) once the backend integrations are
# built — see docs/research/03-signal-expansion-gap-analysis.md.
# COINGLASS_API_KEY=
# CRYPTOQUANT_API_KEY=
# COINMARKETCAL_API_KEY=

# ==================== Admin / manager API ====================
# Static bearer token for /api/admin/* (overview, users, agents, money
# transactions, AI automation management) and the /admin page. Unset =
# the whole admin surface is disabled (503). Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ==================== Research exports (integrity) ====================
# Salt for hashing research-export identifiers (research_exports.py). Set a
# private random value in production so export IDs aren't guessable. If unset,
# the code falls back to a public default. Leave commented to keep the default.
# RESEARCH_EXPORT_HASH_SALT=change-me-to-a-private-random-string
